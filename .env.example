# Proveedor de IA
AI_PROVIDER=deepseek  # "openai", "anthropic" o "deepseek"

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# Configuracion de modelos (opcional)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DEEPSEEK_MODEL=deepseek-chat

# Configuracion de Appium
APPIUM_SERVER_URL=http://localhost:4723
ANDROID_PLATFORM_NAME=Android
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_UDID=emulator-5554  # Opcional: UDID del dispositivo (por defecto usa ANDROID_DEVICE_NAME)
ANDROID_AUTOMATION_NAME=UiAutomator2

# Configuracion de la App Android
# Opcion 1: Usar ruta al APK (recomendado para instalar la app)
ANDROID_APP_PATH=D:/Imagine/gofixi/utils/apk/2025-12-19-cliente.apk
# Opcion 2: Usar package y activity (si la app ya esta instalada)
ANDROID_APP_PACKAGE=com.imagineapps.gofixiicliente
ANDROID_APP_ACTIVITY=.MainActivity

# Configuracion avanzada de Appium
ANDROID_AUTO_GRANT_PERMISSIONS=true
ANDROID_IGNORE_HIDDEN_API_POLICY_ERROR=true
ANDROID_DISABLE_WINDOW_ANIMATION=true

# Timeouts
# DEFAULT_WAIT_TIMEOUT: en MINUTOS (10 = 10 minutos)
# IMPLICIT_WAIT: en SEGUNDOS (5 = 5 segundos)
DEFAULT_WAIT_TIMEOUT=10
IMPLICIT_WAIT=5

# Test Runner - Prevenci�n de loops infinitos
MAX_ACTIONS_PER_STEP=10           # M�ximo de acciones diferentes por paso (default: 10)
MAX_REPEATED_ACTION_ATTEMPTS=3    # M�ximo intentos de la MISMA acci�n (default: 3)
# Credenciales de prueba para tests
TEST_USER_EMAIL=cliente@demo.com
TEST_USER_PASSWORD=123456
# QAI Version (v1 = actual, v2 = conversacional)
QAI_VERSION=v2

ALLOWED_APP_PACKAGES=com.imagineapps.gofixiicliente,com.imagineapps.gofixiitecnico