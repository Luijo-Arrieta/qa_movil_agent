# ============================================================================
# Configuración de Proveedor de IA
# ============================================================================
# Proveedor a usar: "openai", "anthropic" o "deepseek"
AI_PROVIDER=deepseek

# API Keys (solo configurar la del proveedor que uses)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# Modelos por proveedor (opcional - si no se especifica, usa defaults)
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# Configuración de Timeouts y Reintentos de API
# ============================================================================
# Timeout en segundos para llamadas a la API de IA (default: 120)
# AI_API_TIMEOUT=120.0

# Número de reintentos (1 = intento inicial + 1 reintento = 2 oportunidades)
# AI_API_MAX_RETRIES=1

# Segundos de espera entre reintentos (default: 3)
# AI_API_RETRY_DELAY=3.0

# ============================================================================
# Fallback Automático de Proveedores (opcional)
# ============================================================================
# Habilita fallback automático si el proveedor primario falla después de reintentos
# AI_FALLBACK_ENABLED=true

# Orden de proveedores de fallback (separados por coma)
# Ejemplo: Si AI_PROVIDER=deepseek y este falla, intenta anthropic, luego openai
# AI_FALLBACK_PROVIDERS=anthropic,openai

# ============================================================================
# Configuración de Appium
# ============================================================================
APPIUM_SERVER_URL=http://localhost:4723
ANDROID_PLATFORM_NAME=Android
ANDROID_AUTOMATION_NAME=UiAutomator2

# Dispositivo Android (obtén el ID con: adb devices)
ANDROID_DEVICE_NAME=emulator-5554
# ANDROID_UDID=emulator-5554  # Opcional: si no se especifica, usa ANDROID_DEVICE_NAME

# Capabilities avanzadas de Appium (opcional)
# ANDROID_AUTO_GRANT_PERMISSIONS=true
# ANDROID_IGNORE_HIDDEN_API_POLICY_ERROR=true
# ANDROID_DISABLE_WINDOW_ANIMATION=true

# ============================================================================
# Timeouts de Appium
# ============================================================================
# Timeout de comandos Appium en MINUTOS (default: 10)
DEFAULT_WAIT_TIMEOUT=10

# Espera implícita en SEGUNDOS (default: 5)
IMPLICIT_WAIT=5

# ============================================================================
# Apps Permitidas (Scope del Agente)
# ============================================================================
# Lista de packages de apps que el agente puede ver e interactuar
# Separadas por comas, sin espacios
# Ejemplo: com.app1,com.app2,com.app3
ALLOWED_APP_PACKAGES=com.imagineapps.gofixiicliente,com.imagineapps.gofixiitecnico

# ============================================================================
# Configuración de Test Runner
# ============================================================================
# Versión de QAI: "v1" (legacy) o "v2" (conversacional, recomendado)
QAI_VERSION=v2

# Prevención de loops infinitos (opcional)
# MAX_ACTIONS_PER_STEP=10           # Máximo de acciones diferentes por paso
# MAX_REPEATED_ACTION_ATTEMPTS=3    # Máximo intentos de la MISMA acción

# ============================================================================
# Credenciales de Prueba (para tests automatizados)
# ============================================================================
TEST_USER_EMAIL=cliente@demo.com
TEST_USER_PASSWORD=123456

# Prefijo para contraseñas dinámicas (opcional)
# Genera contraseñas con formato: {prefix}{timestamp}
# TEST_PASSWORD_PREFIX=NuevaClave